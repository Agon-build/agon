# Reverse proxy for the ArcRun/Agon backend. Caddy fetches and renews TLS
# certificates automatically through Let's Encrypt. For that to work, ports
# 80 and 443 must be open on the VPS and both subdomains must resolve to this
# host's public IP. The frontends (legacy arcrun.xyz and canonical agon.surf)
# live on Vercel and are not served here.
#
# THIS FILE IS SHARED INGRESS FOR THREE PRODUCTS. This Caddy owns ports 80 and
# 443 on the VPS, so Agent QA (agentsqa.xyz) and Avow (api.avow.site) run their
# own compose projects with no Caddy of their own and join this project's
# default network (deploy_default) to be reached by container name. Three
# consequences, all learned the hard way:
#
#   1. Every site block for them must live HERE, in tracked source. The deploy
#      workflow runs `git reset --hard origin/main` on /opt/arcrun, so a block
#      hand-added on the VPS survives exactly until the next arcrun push. The
#      api.avow.site block below was lost that way and its site stayed dark.
#   2. `docker compose down` in this directory deletes the deploy_default
#      network and takes agentsqa.xyz and api.avow.site down with arcrun. Use
#      `up -d` or restart individual services instead.
#   3. This file lives in its own directory because compose mounts the
#      DIRECTORY, not the file. Do not "tidy" it back up a level and mount
#      ./Caddyfile directly: a single-file bind mount pins one inode, and
#      `git reset --hard` replaces the file rather than writing into it, so the
#      container silently keeps serving the version it started with. That is
#      what hid the avow block for weeks, and it makes `caddy reload` a no-op
#      because the reload re-reads the same stale inode.
#
# Caddy does not watch its config, so a content change still needs a reload.
# The deploy workflow does it after the reset. By hand:
#   docker exec arcrun-caddy caddy reload --config /etc/caddy/Caddyfile

api.arcrun.xyz {
	handle /x402/* {
		reverse_proxy auth:8090
	}

	handle {
		reverse_proxy auth:8082
	}
}

# Agon's canonical API ingress. Keep the legacy api.arcrun.xyz block above
# during the transition; both names reach the same services without redirecting
# signed requests or changing existing clients underneath them.
api.agon.surf {
	handle /api/bnb/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy bnb-api:8789
	}

	handle /x402/* {
		reverse_proxy auth:8090
	}

	handle {
		reverse_proxy auth:8082
	}
}

# WebSocket upgrades are handled transparently by reverse_proxy.
ws.arcrun.xyz {
	reverse_proxy coordinator:8788
}

ws.agon.surf {
	reverse_proxy coordinator:8788
}

# Portable Agent Memory (the Agent-QA repo) deploys its own containers on this
# compose project's default network and borrows this Caddy as its ingress.
agentsqa.xyz {
	# Free, read-only AGON challenge calls execute inside the memory provider.
	handle /agon/v1/* {
		reverse_proxy agentqa-memory:4000
	}

	# The immutable AGON listing manifest is owned by the seller service.
	handle /agon/manifest.json {
		reverse_proxy agentqa-pay:9100
	}

	# The paid lane: OKX marketplace buyers pay here and agentqa-pay forwards to
	# the app once payment clears. Listed first because Caddy matches the most
	# specific handle, and the free console must not end up behind the paywall.
	handle /x402/* {
		reverse_proxy agentqa-pay:9100
	}

	handle {
		reverse_proxy agentqa-app:9090
	}
}

# Avow's agent backend (the avow-deploy compose project in ~/avow-deploy). Same
# arrangement as Agent QA above: its container joins this project's network and
# borrows this Caddy, so its site block belongs in this tracked file.
api.avow.site {
	reverse_proxy avow-agent:8787
}

# sFace. Same arrangement as Agent QA and Avow above: its container joins this
# project's default network and borrows this Caddy as ingress, so its site
# block belongs in this tracked file. The client half is static and lives on
# Vercel at sface.site; only the service is here.
api.sface.site {
	reverse_proxy sface-api:8790
}

# NIM RUSH is the sFace game under its own domain, and the same sface-api
# service answers both names. The client is on Vercel at www.nim-rush.xyz.
api.nim-rush.xyz {
	reverse_proxy sface-api:8790
}

# KOVA (the kova repository's deploy/docker-compose.yml). Same arrangement as
# Agent QA, Avow and sFace above: its container joins this project's default
# network and borrows this Caddy as ingress, so its site block belongs in this
# tracked file. The consumer frontend is on Vercel at kova.surf; only the
# read-only evidence API is served here.
api.kova.surf {
	reverse_proxy kova-api:8787
}

# Splits (the splits repository's deploy/compose.yml, compose project `splits`).
# Same arrangement as Kova and sFace above: splits-api joins this project's
# default network and borrows this Caddy as ingress, so its site blocks belong
# in this tracked file. Unlike them, the whole site is served from here (no
# Vercel): pages and API come from the one Next.js container. Its Postgres
# (splits-db) stays on the splits project's internal network. Agentic mode
# accepts 12MB of screenshots per request (MAX_UPLOAD_BYTES), hence 13MB.
mysplits.xyz {
	request_body {
		max_size 13MB
	}
	reverse_proxy splits-api:3930
}

www.mysplits.xyz {
	redir https://mysplits.xyz{uri} permanent
}
