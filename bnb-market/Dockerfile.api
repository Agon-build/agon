# Node's built-in type stripping runs the same shared server as Next.js.
FROM node:22.23.4-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY src/shared/types.ts ./src/shared/types.ts
COPY src/shared/marketplace ./src/shared/marketplace
COPY src/shared/server ./src/shared/server
COPY src/shared/providers ./src/shared/providers
COPY scripts ./scripts
USER node
EXPOSE 8789
CMD ["node", "--experimental-strip-types", "src/shared/server/serve.ts"]
